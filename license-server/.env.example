NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://woofeeds:change-me@127.0.0.1:5432/woofeeds
DATABASE_SSL=false
ADMIN_API_TOKEN=replace-with-at-least-32-random-characters
LICENSE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
PUBLIC_APP_URL=https://licenses.example.com

# Optional payment adapters. Configure either or both after choosing a provider.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_IDS=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=production
PADDLE_PRODUCT_IDS=

# Buyer delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WooFeeds Pro <licenses@example.com>"

